[Unit]
Description=sparetoken CEO heartbeat (unittest + Cursor Agent)
After=network.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/development/guest-sessions/session-20260829-212831-83c1eb/workspace/wdtsot
Environment=TZ=America/Sao_Paulo
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=GIT_AUTHOR_NAME=sparetoken
Environment=GIT_AUTHOR_EMAIL=sparetoken-shop@users.noreply.github.com
Environment=GIT_COMMITTER_NAME=sparetoken
Environment=GIT_COMMITTER_EMAIL=sparetoken-shop@users.noreply.github.com
TimeoutStartSec=7200
StandardOutput=journal
StandardError=journal
ExecStart=/home/ubuntu/development/guest-sessions/session-20260829-212831-83c1eb/workspace/wdtsot/ceo/launch/heartbeat.sh
